{
  "name": "life-assistant",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "eslint . --max-warnings=0",
    "audit:v2-css": "node scripts/verify-v2-theme-css.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --project integration",
    "test:e2e": "node scripts/prepare-e2e.mjs && playwright test",
    "test:e2e:core:isolated": "node scripts/prepare-e2e.mjs && cross-env LIFE_ASSISTANT_E2E_PORT=43122 playwright test",
    "test:e2e:isolated": "node scripts/run-isolated-e2e.mjs",
    "test:e2e:v2-baseline": "node scripts/prepare-v2-visual.mjs && playwright test --config playwright.v2-visual.config.ts",
    "test:e2e:v2-baseline:update": "cross-env LIFE_ASSISTANT_UPDATE_BASELINES=1 pnpm test:e2e:v2-baseline",
    "test:e2e:v2-rebaseline": "node scripts/prepare-v2-rebaseline.mjs && playwright test --config playwright.v2-rebaseline.config.ts",
    "test:e2e:v2-rebaseline:update": "cross-env LIFE_ASSISTANT_UPDATE_BASELINES=1 pnpm test:e2e:v2-rebaseline",
    "test:e2e:v2-foundations": "node scripts/prepare-v2-foundations.mjs && playwright test --config playwright.v2-foundations.config.ts",
    "test:e2e:v2-work": "node scripts/prepare-v2-work.mjs && playwright test --config playwright.v2-work.config.ts",
    "test:e2e:v2-life": "node scripts/prepare-v2-life.mjs && playwright test --config playwright.v2-life.config.ts",
    "test:e2e:v2-vision": "node scripts/prepare-v2-vision.mjs && playwright test --config playwright.v2-vision.config.ts",
    "test:e2e:v2-assistant": "node scripts/prepare-v2-assistant.mjs && playwright test --config playwright.v2-assistant.config.ts",
    "test:e2e:v2-a19-a20": "node scripts/prepare-v2-a19-a20.mjs && playwright test --config playwright.v2-a19-a20.config.ts",
    "test:e2e:v2-system": "node scripts/prepare-v2-system.mjs && playwright test --config playwright.v2-system.config.ts",
    "test:e2e:v2-cross-theme": "node scripts/prepare-v2-cross-theme.mjs && playwright test --config playwright.v2-cross-theme.config.ts",
    "test:performance": "cross-env RUN_PERFORMANCE=1 vitest run apps/server/test/performance.bench.test.ts",
    "test:openai-smoke": "cross-env RUN_OPENAI_SMOKE=1 vitest run apps/server/test/openai-manual-smoke.test.ts",
    "launcher:build": "node scripts/run-dotnet.mjs build apps/launcher/LifeAssistant.Launcher.csproj --configuration Release",
    "launcher:test-crash-restart": "node scripts/verify/launcher-crash-restart-check.mjs",
    "launcher:publish": "node scripts/run-dotnet.mjs publish apps/launcher/LifeAssistant.Launcher.csproj --configuration Release --runtime win-x64 --self-contained true -p:PublishSingleFile=true",
    "contracts:generate": "pnpm --filter @life-assistant/contracts generate",
    "contracts:check": "pnpm --filter @life-assistant/contracts generate:check",
    "fixtures:benchmark": "tsx packages/database/src/benchmark-cli.ts",
    "release:preflight": "node scripts/release/assert-clean.mjs",
    "release:portable": "pnpm release:preflight && pnpm build && pnpm launcher:publish && node scripts/release/build-portable.mjs",
    "release:windows": "pnpm release:portable && node scripts/release/build-windows-zip.mjs",
    "release:verify": "node scripts/release/verify-portable.mjs",
    "release:clean-check": "node scripts/verify/clean-install-check.mjs",
    "verify": "pnpm format:check && pnpm lint && pnpm audit:v2-css && pnpm typecheck && pnpm test && pnpm contracts:check && pnpm build && pnpm launcher:build && pnpm launcher:test-crash-restart"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "cross-env": "^10.1.0",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "tsup": "^8.5.1",
    "tsx": "^4.23.11",
    "turbo": "^2.10.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  }
}
